{
  "version": "v1.0",
  "scenario": "NORMAL",
  "description": "常规业务对话测试集 — 覆盖客服五大意图类别：return_policy, order_query, product_info, payment, greeting。含成功用例 20 个与失败用例 15 个。",
  "cases": [
    {
      "id": "NORMAL-001",
      "query": "这条裤子的退货政策是什么？",
      "expectedIntent": "return_policy",
      "expectedTool": null,
      "expectedKnowledge": ["7天", "无理由", "退货"],
      "expectedAnswer": "您可以在购买后7天内无理由退货。请保持商品吊牌完整并携带原始包装。",
      "expectedFailureReason": null,
      "mockResponse": "根据我们的退货政策，您可以在购买后7天内无理由退货。请保持商品吊牌完整，并携带原始包装。退货申请审核通过后，我们将在3个工作日内处理退款。"
    },
    {
      "id": "NORMAL-002",
      "query": "我想查询订单ORD2024001的物流状态",
      "expectedIntent": "order_query",
      "expectedTool": "queryOrder",
      "expectedKnowledge": ["订单状态", "物流"],
      "expectedAnswer": "您的订单ORD2024001当前状态为运输中，快递单号SF1234567890，预计2天后送达。",
      "expectedFailureReason": null,
      "mockResponse": "正在使用queryOrder工具为您查询订单ORD2024001的物流状态... 您的订单当前状态为：运输中。快递单号：SF1234567890，预计2天后送达。您也可以通过物流页面实时追踪包裹位置。"
    },
    {
