# ============================================================
#  ShopMind Docker 环境变量模板
#  复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会提交）
# ============================================================

# ----- Profile 切换（default=Mock / qwen / deepseek）-----
SPRING_PROFILES_ACTIVE=default

# ----- Qwen（DashScope）—— 支持 Embedding（RAG 可用）-----
QWEN_API_KEY=
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v3

# ----- DeepSeek —— 无 Embedding API，RAG 不可用 -----
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
